# funkybar
#
# Copy to ~/.config/funkybar/funkybar.toml and edit. Nothing here is required;
# every item is optional and the bar renders whatever you declare.
#
# Two substitution syntaxes, deliberately distinct:
#   $name      a theme token, substituted once at load. Must be the whole value.
#   {field}    a provider field, substituted on every update. `{{` is a literal brace.
# That is why "${price}" is unambiguous: the $ is literal because the value is
# not exactly a token reference, and {price} interpolates.

[bar]
height   = 36
edge     = "top"
offset   = { x = 0, y = 4 }
padding  = { left = 10, right = 10 }
color    = "#00000000"
displays = "all"
sticky   = true
topmost  = "window"

# ==============================================================================
# Theme: Cursor Dark (#141414) with a warm amber accent
# ==============================================================================
[theme]
pill_bg     = "#141414"
pill_border = "#3d2f1a"
accent      = "#f4d35e"
accent_dim  = "#7a6a4a"
text        = "#f1d9a4"
app_name    = "#ffb87c"

ok    = "#56d364"
warn  = "#d29922"
error = "#ff7b72"
idle  = "#6e7681"

# A whole style table can be a token. `style = "$pill"` pulls this in.
[theme.pill]
color         = "$pill_bg"
border_color  = "$pill_border"
border_width  = 1
corner_radius = 12
height        = 24

[theme.mono]
family = "JetBrainsMono Nerd Font"
style  = "Bold"
size   = 14

[theme.mono_small]
family = "JetBrainsMono Nerd Font"
style  = "Bold"
size   = 12

# ==============================================================================
# Defaults, inherited by every item
# ==============================================================================
[defaults]
margin = { left = 3, right = 3 }

[defaults.icon]
font    = "$mono"
color   = "$text"
padding = { left = 10, right = 4 }

[defaults.label]
font    = "$mono_small"
color   = "$text"
padding = { left = 4, right = 10 }

[defaults.style]
color         = "$pill_bg"
border_color  = "$pill_border"
border_width  = 1
corner_radius = 12
height        = 24

# ==============================================================================
# LEFT
# ==============================================================================

# One item per AeroSpace workspace. `repeat = "workspace"` expands at runtime
# from what the provider reports, so a workspace that appears or empties is
# reflected without a reload. Delete this group if you do not use AeroSpace.
[[group]]
id       = "workspaces_pill"
position = "left"
style    = "$pill"

  [[group.item]]
  id       = "space"
  provider = "aerospace"
  repeat   = "workspace"
  on_click = { workspace = "{workspace}" }

    [group.item.icon]
    text    = "{workspace}"
    font    = "$mono"
    padding = { left = 7, right = 7 }

    [group.item.label]
    drawing = false

    [group.item.style]
    drawing = false

    # Selected by the provider's `state` field.
    [group.item.states.active]
    icon_color = "$accent"

    [group.item.states.inactive]
    icon_color = "$accent_dim"

[[group]]
id       = "app_pill"
position = "left"
style    = "$pill"
margin   = { left = 8, right = 3 }

  [[group.item]]
  id   = "chevron"

    [group.item.icon]
    text    = "›"
    color   = "$accent_dim"
    padding = { left = 12, right = 4 }

    [group.item.label]
    drawing = false

    [group.item.style]
    drawing = false

  [[group.item]]
  id       = "front_app"
  provider = "frontApp"

    [group.item.icon]
    drawing = false

    [group.item.label]
    text    = "{name}"
    color   = "$app_name"
    padding = { left = 4, right = 12 }
    font    = { family = "JetBrainsMono Nerd Font", style = "Bold", size = 13 }

    [group.item.style]
    drawing = false

# ==============================================================================
# RIGHT, declared in visual left-to-right order
#
# SketchyBar inserts `right` items rightmost-first, so a sketchybarrc has to
# declare that side backwards. Here the order you write is the order you see.
# ==============================================================================

# Listening dev ports, read in-process via proc_pidinfo rather than shelling
# out to lsof. Click for a popup listing each port and process; a row with a
# ✕ kills what it names.
[[item]]
id       = "ports"
position = "right"
interval = "5s"
icon     = "󰒍"

  [item.label]
  text = "{label}"

  [item.provider]
  kind  = "ports"
  ports = [3000, 3001, 5173, 8080]
  # Processes to report by name, whatever port they use.
  watch = []

  [item.popup]
  on      = "click"
  dismiss = ["mouse_exit", "click_outside"]
  # "columns" lines the labels up so ports and process names align.
  # "compact" puts each label straight after its icon, as sketchybar does.
  rows    = "columns"

    # The sketchybarrc sets these as popup.background.*; here the popup has a
    # style like anything else that draws a box.
    [item.popup.style]
    color         = "$pill_bg"
    border_color  = "$pill_border"
    border_width  = 1
    corner_radius = 12
    padding       = { left = 6, right = 6, top = 6, bottom = 6 }

  [item.states.chain]
  color = "$ok"

  [item.states.ports]
  color = "$warn"

  [item.states.idle]
  color = "$idle"

# Event-driven through IOPSNotificationCreateRunLoopSource: no polling, no pmset.
[[item]]
id       = "battery"
position = "right"
margin   = { left = 6, right = 3 }

  [item.icon]
  text    = "{icon}"
  padding = { left = 10, right = 4 }

  [item.label]
  text    = "{percent}%"
  padding = { left = 4, right = 10 }

  [item.provider]
  kind     = "battery"
  ramp     = ["󰂃", "󰁻", "󰁾", "󰂀", "󰂂"]
  charging = "󰂄"

[[item]]
id       = "clock"
position = "right"

  [item.icon]
  drawing = false

  [item.label]
  text    = "{time}  {date}"
  padding = { left = 12, right = 12 }

  [item.provider]
  kind = "clock"
  # One timer aligned to the minute boundary, shared with every other interval
  # provider, rather than a fast poll that forks a process each tick.
  time = "HH:mm"
  date = "EEE dd"

# ==============================================================================
# Wiring your own applications
# ==============================================================================
#
# A `push` provider reads state another program writes, and watches the file so
# updates land immediately. The other program needs no changes beyond the file
# it already writes.
#
#   [[item]]
#   id       = "myapp"
#   position = "right"
#
#     [item.provider]
#     kind      = "push"
#     channel   = "myapp"
#     seed_file = "~/.local/state/myapp-status"
#
#     # Named commands a click can invoke.
#     [item.provider.commands]
#     toggle = "echo toggle > ~/.local/state/myapp-command"
#
#     [item.on_click]
#     left = "myapp:toggle"
#
#     # States pick icon, label and colour from the provider's `state` field.
#     [item.states.ON]
#     icon  = "\u{f099d}"
#     label = "ON"
#     color = "$ok"
#
#     [item.states.OFF]
#     icon  = "\u{f099e}"
#     label = "OFF"
#     color = "$idle"
#
# For a file holding several values, split it across repeated items:
#
#     seed_file  = "~/.local/state/prices"   # e.g. "75.85 1916.11 64943"
#     seed_keys  = ["a", "b", "c"]     # positional, one per clone
#     seed_field = "price"
#     # then on the item: repeat = ["a", "b", "c"] and text = "${price}"
